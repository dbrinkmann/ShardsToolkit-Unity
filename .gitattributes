# Single repo-wide Git attributes: line endings, text types, and Git LFS.

# Default: normalize line endings on commit
* text=auto

# --- Text: C# / scripts / markup ---
*.cs text diff=csharp
*.shader text
*.cginc text
*.hlsl text
*.compute text
*.glslinc text
*.rsp text
*.xml text
*.json text
*.txt text
*.md text
*.yaml text
*.yml text
*.cpp text

# --- Unity YAML assets: text=auto, NOT plain 'text'. These types can be
# force-binary-serialized, and unconditional 'text' corrupts those on checkout
# via CRLF conversion. text=auto lets git detect binary content and leave it alone.
*.meta text=auto
*.prefab text=auto
*.asset text=auto
*.mat text=auto
*.anim text=auto
*.controller text=auto
*.overrideController text=auto
*.physicMaterial text=auto
*.physicsMaterial2D text=auto
*.playable text=auto
*.preset text=auto
*.mask text=auto
*.brush text=auto
*.spriteatlas text=auto
*.terrainlayer text=auto
*.mixer text=auto
*.signal text=auto
*.shadersubgraph text=auto
*.shadergraph text=auto
*.vfx text=auto
*.inputactions text=auto
*.uxml text=auto
*.uss text=auto
*.lighting text=auto
*.cubemap text=auto
*.flare text=auto
*.rendertexture text=auto
*.guiskin text=auto
*.asmdef text=auto
*.js text=auto
*.html text=auto
*.plist text=auto
*.ini text=auto
*.csv text=auto
*.fnt text=auto
*.rtf text=auto
*.info text=auto

# --- Git LFS: 3D / DCC ---
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.OBJ filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.3ds filter=lfs diff=lfs merge=lfs -text
*.dxf filter=lfs diff=lfs merge=lfs -text
*.spm filter=lfs diff=lfs merge=lfs -text

# --- Git LFS: Unity scenes (often >50MB; GitHub blob limit 100MB) ---
*.unity filter=lfs diff=lfs merge=lfs -text

# --- Git LFS: large binary-serialized terrain .asset files ---
# Most .asset files are tiny YAML and stay in git as text. Toolkit-shipped
# terrain template assets are >20 MB binary-serialized; track them via LFS.
**/EditorTools/Materials/CollisionTerrain.asset filter=lfs diff=lfs merge=lfs -text

# --- Git LFS: Chromium / CEF (e.g. ZFBrowser) ---
*.pak filter=lfs diff=lfs merge=lfs -text
# macOS .app / .framework bundles contain extensionless binaries >100MB
client/Unity/Assets/COTS/ZFBrowser/**/*.app/** filter=lfs diff=lfs merge=lfs -text
client/Unity/Assets/COTS/ZFBrowser/**/*.framework/** filter=lfs diff=lfs merge=lfs -text

